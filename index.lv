<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>moreStrikey.lv — Professional Products</title>
  <meta name="description" content="moreStrikey.lv — quality products, carefully selected. Business website." />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <a class="logo" href="#home">moreStrikey<span class="dot">.lv</span></a>
      <nav class="nav" id="nav">
        <a href="#home">Home</a>
        <a href="#about">About</a>
        <a href="#services">Services</a>
        <a href="#gallery">Gallery</a>
        <a href="#contact">Contact</a>
      </nav>
      <button class="nav-toggle" id="navToggle" aria-label="Open navigation">☰</button>
    </div>
  </header>

  <main>
    <!-- HERO -->
    <section id="home" class="hero">
      <div class="container hero-grid">
        <div class="hero-content">
          <h1>moreStrikey.lv</h1>
          <p class="subtitle">Curated products &amp; smart solutions for your everyday needs.</p>
          <p class="cta-note">Different kinds of products — updated regularly. Professional service, fast support.</p>
          <div class="hero-cta">
            <a class="btn primary" href="#services">Our Services</a>
            <a class="btn ghost" href="#contact">Get in touch</a>
          </div>
        </div>
        <div class="hero-image" aria-hidden="true">
          <!-- Placeholder image area: replace with your image file -->
          <div class="image-placeholder">Your product images here</div>
        </div>
      </div>
    </section>

    <!-- ABOUT -->
    <section id="about" class="section about">
      <div class="container">
        <h2>About moreStrikey.lv</h2>
        <p class="lead">We source and offer a range of high-quality products. We're a small, customer-focused business that aims to combine style, value and excellent support. Products change as we test and expand our range — check back often or contact us for special requests.</p>
        <div class="about-grid">
          <div>
            <h3>Quality</h3>
            <p>We vet every product to make sure it meets our standards.</p>
          </div>
          <div>
            <h3>Customer-first</h3>
            <p>Fast answers and clear returns. We treat customers like partners.</p>
          </div>
          <div>
            <h3>Flexible</h3>
            <p>Need a bulk order or custom inquiry? Contact us — we’ll help find a solution.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- SERVICES -->
    <section id="services" class="section services">
      <div class="container">
        <h2>Services & Offerings</h2>
        <p class="lead">We offer product sales, bulk order support and tailored sourcing. (You can list specific product categories here.)</p>
        <div class="services-grid">
          <article class="card">
            <h4>Product Sourcing</h4>
            <p>We help find the right items and ensure quality control before sale.</p>
          </article>
          <article class="card">
            <h4>Retail & Small Wholesale</h4>
            <p>Buy single items or contact us for small-batch wholesale pricing.</p>
          </article>
          <article class="card">
            <h4>Consultation</h4>
            <p>Need product recommendations? We advise on trending items and pricing.</p>
          </article>
          <article class="card">
            <h4>Fast Support</h4>
            <p>Clear communication and quick shipping coordination.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- GALLERY -->
    <section id="gallery" class="section gallery">
      <div class="container">
        <h2>Gallery</h2>
        <p class="lead">A visual preview of items. Replace these placeholders with your own product photos.</p>
        <div class="gallery-grid" id="galleryGrid">
          <!-- Replace these <figure> blocks with your images -->
          <figure><img src="https://via.placeholder.com/600x400?text=Product+1" alt="Product 1"><figcaption>Product 1</figcaption></figure>
          <figure><img src="https://via.placeholder.com/600x400?text=Product+2" alt="Product 2"><figcaption>Product 2</figcaption></figure>
          <figure><img src="https://via.placeholder.com/600x400?text=Product+3" alt="Product 3"><figcaption>Product 3</figcaption></figure>
          <figure><img src="https://via.placeholder.com/600x400?text=Product+4" alt="Product 4"><figcaption>Product 4</figcaption></figure>
        </div>
      </div>
    </section>

    <!-- CONTACT -->
    <section id="contact" class="section contact">
      <div class="container contact-grid">
        <div>
          <h2>Contact</h2>
          <p class="lead">Ready to order or ask something? Send us a message and we'll reply fast.</p>
          <ul class="contact-list">
            <li><strong>Email:</strong> <a href="mailto:info@morestrikey.lv">info@morestrikey.lv</a></li>
            <li><strong>Phone/WhatsApp:</strong> +371 00 000 000 (replace with yours)</li>
            <li><strong>Location:</strong> Riga, Latvia (example)</li>
          </ul>
        </div>

        <form id="contactForm" class="form" onsubmit="handleContact(event)">
          <label>
            <span>Name</span>
            <input type="text" name="name" id="name" required>
          </label>
          <label>
            <span>Email</span>
            <input type="email" name="email" id="email" required>
          </label>
          <label>
            <span>Message</span>
            <textarea name="message" id="message" rows="5" required></textarea>
          </label>
          <div class="form-actions">
            <button class="btn primary" type="submit">Send message</button>
            <button class="btn ghost" type="button" onclick="contactMailto()">Email instead</button>
          </div>
          <p class="small-note">This form uses your email client to send (or you can configure a form service later).</p>
        </form>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container footer-inner">
      <p>© <span id="year"></span> moreStrikey.lv — All rights reserved.</p>
      <nav class="footer-nav">
        <a href="#privacy">Privacy</a>
        <a href="#terms">Terms</a>
      </nav>
    </div>
  </footer>

  <script src="script.js"></script>
</body>
</html>
